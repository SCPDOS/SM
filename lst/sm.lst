   143 0000047A 488B1D(30000000)    <1>     mov rbx, qword [pCurSess]
   144 00000481 488D6330            <1>     lea rsp, qword [rbx + psda.sRegsTbl + 8]    ;Skip reloading the flags here!
   145                              <1> ;We load the flags to their original state after we have switched back to the 
   146                              <1> ; application stack because we start applications with Interrupts on. Thus,
   147                              <1> ; if an interrupt occurs during the popping of the register stack, this 
   148                              <1> ; may corrupt data in the psda. Thus we only load rflags once we are on the
   149                              <1> ; application stack (which in the dangerous case, i.e. program init, is 
   150                              <1> ; always large enough to handle an interrupt... unless its a very full .COM file)!
   151 00000485 415F                <1>     pop r15
   152 00000487 415E                <1>     pop r14
   153 00000489 415D                <1>     pop r13
   154 0000048B 415C                <1>     pop r12
   155 0000048D 415B                <1>     pop r11
   156 0000048F 415A                <1>     pop r10
   157 00000491 4159                <1>     pop r9
   158 00000493 4158                <1>     pop r8
   159 00000495 5D                  <1>     pop rbp
   160 00000496 5F                  <1>     pop rdi
   161 00000497 5E                  <1>     pop rsi
   162 00000498 5A                  <1>     pop rdx
   163 00000499 59                  <1>     pop rcx
   164 0000049A 5B                  <1>     pop rbx
   165 0000049B 58                  <1>     pop rax
   166 0000049C 48871D(30000000)    <1>     xchg qword [pCurSess], rbx
   167 000004A3 488B6320            <1>     mov rsp, qword [rbx + psda.qRSP]
   168 000004A7 FF7328              <1>     push qword [rbx + psda.sRegsTbl]    ;Reload the flags once we have switched stacks!
   169 000004AA 48871D(30000000)    <1>     xchg qword [pCurSess], rbx  ;Now swap things back  
   170 000004B1 9D                  <1>     popfq   ;Pop flags back right at the end :)
   171                              <1>     return
