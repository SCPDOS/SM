   173                              <1> swapSession:
   174                              <1> ;Saves the current session information and sets the session information for a 
   175                              <1> ; new session. Is called with interrupts turned off!
   176                              <1> ;Input: ecx = Session number to switch to.
   177                              <1> ;       dword [dCurSess], qword [pCurSess] -> Current session identifiers.
   178                              <1> ;Output: ecx set as current session.
   179                              <1> ;Must be called on a safe to use stack.
   180 000004B3 89CD                <1>     mov ebp, ecx    ;Save the session number in ebp!
   181                              <1> 
   182 000004B5 488D3D(30000000)    <1>     lea rdi, pCurSess
   183 000004BC 488B3D(30000000)    <1>     mov rdi, qword [pCurSess]
   184 000004C3 57                  <1>     push rdi    ;Save the CurSess pointer for use later!
   185 000004C4 488DBFA8000000      <1>     lea rdi, qword [rdi + psda.sdaCopy] ;Point rdi to the sda space
   186 000004CB 488B35(00000000)    <1>     mov rsi, qword [pDosSda]
   187 000004D2 8B0D(14000000)      <1>     mov ecx, dword [dSdaLen]
   188 000004D8 F3A4                <1>     rep movsb   ;Transfer over the SDA
   189 000004DA 5F                  <1>     pop rdi
   190                              <1> ;Save the current Int 22h, 23h and 24h handlers in the paused sessions' PSDA.
   191 000004DB B822000000          <1>     mov eax, 22h
   192 000004E0 E89F000000          <1>     call getIntVector
   193 000004E5 48891F              <1>     mov qword [rdi + psda.pInt22h], rbx
   194 000004E8 B823000000          <1>     mov eax, 23h
   195 000004ED E892000000          <1>     call getIntVector
   196 000004F2 48895F08            <1>     mov qword [rdi + psda.pInt23h], rbx
   197 000004F6 B824000000          <1>     mov eax, 24h
   198 000004FB E884000000          <1>     call getIntVector
   199 00000500 48895F10            <1>     mov qword [rdi + psda.pInt24h], rbx
   200 00000504 B82E000000          <1>     mov eax, 2Eh
   201 00000509 E876000000          <1>     call getIntVector
   202 0000050E 48895F18            <1>     mov qword [rdi + psda.pInt2Eh], rbx
   203                              <1> ;-----------------------------------------------------------------
   204                              <1> ;-----------------NEW SESSION IS SWAPPED TO BELOW-----------------
   205                              <1> ;-----------------------------------------------------------------
   206                              <1> ;Set the new session as the current active session
   207 00000512 892D(2C000000)      <1>     mov dword [dCurSess], ebp  ;Store the session number
   208 00000518 89E9                <1>     mov ecx, ebp  
   209 0000051A E8B7000000          <1>     call getPsdaPtr ;Get ptr in rdi to the current PSDA table
   210 0000051F 4889FB              <1>     mov rbx, rdi
   211 00000522 48891D(30000000)    <1>     mov qword [pCurSess], rbx           ;Setup internal data properly!
   212                              <1> 
   213                              <1> ;Set the SDA to the new session's SDA. 
   214 00000529 488DB3A8000000      <1>     lea rsi, qword [rbx + psda.sdaCopy] ;Point rdi to the sda space
   215 00000530 488B3D(00000000)    <1>     mov rdi, qword [pDosSda]
   216 00000537 8B0D(14000000)      <1>     mov ecx, dword [dSdaLen]
   217 0000053D F3A4                <1>     rep movsb   ;Transfer over the SDA
   218                              <1> 
   219                              <1> ;Set the new sessions' DOS interrupt handlers.
   220 0000053F 488B5318            <1>     mov rdx, qword [rbx + psda.pInt2Eh]
   221 00000543 B82E000000          <1>     mov eax, 2Eh
   222 00000548 E861000000          <1>     call setIntVector    
   223 0000054D 488B5310            <1>     mov rdx, qword [rbx + psda.pInt24h]
   224 00000551 B824000000          <1>     mov eax, 24h
   225 00000556 E853000000          <1>     call setIntVector
   226 0000055B 488B5308            <1>     mov rdx, qword [rbx + psda.pInt23h]
   227 0000055F B823000000          <1>     mov eax, 23h
   228 00000564 E845000000          <1>     call setIntVector
   229 00000569 488B13              <1>     mov rdx, qword [rbx + psda.pInt22h]
   230 0000056C B822000000          <1>     mov eax, 22h
   231 00000571 E838000000          <1>     call setIntVector 
   232                              <1> 
   233                              <1> ;Now swap the screen to new sessions' screen!
   234 00000576 89EB                <1>     mov ebx, ebp        ;Put the session number in bl
   235 00000578 B801000000          <1>     mov eax, 1          ;Swap screen command!
   236 0000057D FF15(1C000000)      <1>     call qword [pConIOCtl] ;Set the screen to the number in bl
   237                              <1> 
   238                              <1>     return
    13 00000583 C3                  <2>  ret
