   276                              <1> ;Output: rdi -> PSDA requested
   277 000005D6 488B3D(08000000)    <1>     mov rdi, qword [pPsdaTbl]
   278 000005DD 85C9                <1>     test ecx, ecx   ;Pick off the case where session number is 0.
   279                              <1>     retz
    23                              <2> cret z
    17 000005DF 7501                <3>  j%-1 short %%a
    18                              <3>  return
    13 000005E1 C3                  <4>  ret
