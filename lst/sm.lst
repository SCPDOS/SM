   101                              <1> ;Shell handy routines
   102                              <1> getProcName:
   103                              <1> ;Input: rdx -> PSP pointer to find the task name for!
   104                              <1> ;Output: CF=NC: rdx -> Points to ASCIIZ process name
   105                              <1> ;        CF=CY: rdx = 0, Process name not found
   106                              <1> ;
   107                              <1> ;Here we search for the double 00 and then check if it is 0001 and
   108                              <1> ; pass the ptr to the word after.
   109 0000073C 488B523E            <1>     mov rdx, qword [rdx + psp.envPtr]   ;Get the environement pointer
   110 00000740 FA                  <1>     cli
   111 00000741 51                  <1>     push rcx
   112 00000742 31C9                <1>     xor ecx, ecx
   113 00000744 B9FF7F0000          <1>     mov ecx, 7FFFh  ;Max environment size
   114                              <1> .gep0:
   115 00000749 66813A0000          <1>     cmp word [rdx], 0   ;Zero word?
   116 0000074E 740D                <1>     je short .gep1
   117 00000750 48FFC2              <1>     inc rdx         ;Go to the next byte
   118 00000753 FFC9                <1>     dec ecx
   119 00000755 75F2                <1>     jnz short .gep0
   120                              <1> .gep00:
   121                              <1>     ;Failure here if we haven't hit the double null by the end of 32Kb
   122 00000757 59                  <1>     pop rcx
   123 00000758 31D2                <1>     xor edx, edx    ;Turn it into null pointer
   124 0000075A F9                  <1>     stc     ;Set CF
   125 0000075B EB17                <1>     jmp short .exit ;Exit reenabling the interrupts!
   126                              <1> .gep1:
   127 0000075D 4881C202000000      <1>     add rdx, 2  ;Skip the double null
   128 00000764 66813A0100          <1>     cmp word [rdx], 1   ;Check if one more string in environment
   129 00000769 75EC                <1>     jne .gep00
   130 0000076B 4881C202000000      <1>     add rdx, 2  ;Skip the 0001 word. Should always clear CF
   131 00000772 59                  <1>     pop rcx
   132 00000773 F8                  <1>     clc     ;Clear CF
   133                              <1> .exit:
   134 00000774 FB                  <1>     sti
   135                              <1>     return
    13 00000775 C3                  <2>  ret
   136                              <1> putch:
   137 00000776 B800020000          <1>     mov eax, 0200h
   138 0000077B CD21                <1>     int 21h
   139                              <1>     return
    13 0000077D C3                  <2>  ret
   140                              <1> puts:
   141 0000077E B800090000          <1>     mov eax, 0900h
   142 00000783 CD21                <1>     int 21h
   143                              <1>     return
