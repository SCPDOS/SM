     1                              <1> ;This is the main Session Manager "interactive" shell.
     2                              <1> 
     3                              <1>     EXTERN sm$shlTOS
     4                              <1> 
     5                              <1> shellEntry:
     6                              <1> ;This is the entry stub into the SM shell!
     7 000005F2 488D25(00000000)    <1>     lea rsp, sm$shlTOS  ;Set now to internal shell stack! 
     8 000005F9 FB                  <1>     sti     ;Now reenable interrupts! We are safe to do so! 
     9                              <1> ;And fall through to the main print loop
    10                              <1> shellMain:
    11                              <1> ;The shell main routine prints the number of sessions,
    12                              <1> ; the program names.
    13 000005FA E831010000          <1>     call resetScreen
    14                              <1> ;Printing the screen header!
    15 000005FF 488D15(69030000)    <1>     lea rdx, ttlStr
    16 00000606 E873010000          <1>     call puts
    17 0000060B 488D15(82020000)    <1>     lea rdx, sessStr
    18 00000612 E867010000          <1>     call puts
    19 00000617 8B15(18000000)      <1>     mov edx, dword [dMaxSesIndx]    ;This is also number of USER sessions
    20 0000061D FFC2                <1>     inc edx     ;Add 1 to include the SM session
    21 0000061F 80C230              <1>     add dl, "0" ;Convert to ASCII char
    22 00000622 E84F010000          <1>     call putch
    23 00000627 E85A010000          <1>     call putNewline
    24 0000062C 488D15(31020000)    <1>     lea rdx, uline
    25 00000633 E846010000          <1>     call puts
    26 00000638 E849010000          <1>     call putNewline
    27                              <1> ;Printing the sessions.
    28 0000063D B230                <1>     mov dl, "0"
    29 0000063F E832010000          <1>     call putch
    30 00000644 488D15(CA020000)    <1>     lea rdx, colonStr
    31 0000064B E82E010000          <1>     call puts
    32 00000650 488D15(26030000)    <1>     lea rdx, sesManStr
    33 00000657 E822010000          <1>     call puts
    34 0000065C E825010000          <1>     call putNewline
    35                              <1> ;Now we print the name from each session's current PSP environment pointer.
    36 00000661 B901000000          <1>     mov ecx, 1  ;Start from this session number
    37                              <1> .printLp:
    38 00000666 89CA                <1>     mov edx, ecx
    39 00000668 80C230              <1>     add dl, "0" 
    40 0000066B E806010000          <1>     call putch
    41 00000670 488D15(CA020000)    <1>     lea rdx, colonStr
    42 00000677 E802010000          <1>     call puts
    43 0000067C 488D15(16030000)    <1>     lea rdx, waitStr    ;Now print the state of the session
    44 00000683 E8F6000000          <1>     call puts
    45                              <1>     ;Now get the string to print
    46 00000688 E849FFFFFF          <1>     call getPsdaPtr ;Get the psda ptr in rdi
    47 0000068D 488B97C0000000      <1>     mov rdx, qword [rdi + psda.sdaCopy + sda.currentPSP]    ;Get the PSPptr
    48 00000694 E8A3000000          <1>     call getProcName    ;Get the process name ptr for process of PSP in rdx
    49 00000699 730E                <1>     jnc .nameFound
    50 0000069B 488D15(4B030000)    <1>     lea rdx, noNameStr
    51 000006A2 E8D7000000          <1>     call puts
    52 000006A7 EB1A                <1>     jmp short .nextSession
    53                              <1> .nameFound:
    54 000006A9 4889D7              <1>     mov rdi, rdx    ;Copy the ptr here to get the len of the ASCIIZ string
    55 000006AC 51                  <1>     push rcx        ;Save the number of the psda we are at
    56 000006AD B812120000          <1>     mov eax, 1212h
    57 000006B2 CD2F                <1>     int 2Fh
    58                              <1>     ;ecx now has the string length + terminating null
    59                              <1>     ;rdx points to the ASCIIZ string
    60 000006B4 FFC9                <1>     dec ecx     ;Drop the terminating null
    61 000006B6 BB01000000          <1>     mov ebx, 1  ;STDOUT
    62 000006BB B800400000          <1>     mov eax, 4000h
    63 000006C0 CD21                <1>     int 21h
    64 000006C2 59                  <1>     pop rcx     ;Get back the psda number
    65                              <1> .nextSession:
    66 000006C3 E8BE000000          <1>     call putNewline
    67 000006C8 FFC1                <1>     inc ecx
    68 000006CA 390D(18000000)      <1>     cmp dword [dMaxSesIndx], ecx   ;Keep going until dMaxSesIndx < ecx
    69 000006D0 7394                <1>     jae .printLp
    70                              <1> ;All printing done, now wait for input from user
    71 000006D2 488D15(F4020000)    <1>     lea rdx, helpStr
    72 000006D9 E8A0000000          <1>     call puts
    73 000006DE 488D15(CD020000)    <1>     lea rdx, promptStr
    74 000006E5 E894000000          <1>     call puts
    75 000006EA 488D15(3D000000)    <1>     lea rdx, inStr
    76 000006F1 66C7020200          <1>     mov word [rdx], 0002h   ;Init the buffered string
    77 000006F6 B8000A0000          <1>     mov eax, 0A00h  ;Await buffered input
    78 000006FB CD21                <1>     int 21h
    79 000006FD 0FB64A02            <1>     movzx ecx, byte [rdx + 2]
    80 00000701 80F93F              <1>     cmp cl, "?"
    81 00000704 0F84F0FEFFFF        <1>     je shellMain
    82 0000070A 80F931              <1>     cmp cl, "1"
    83 0000070D 7215                <1>     jb badChoice
    84 0000070F 80F939              <1>     cmp cl, "9"
    85 00000712 7710                <1>     ja badChoice
    86 00000714 80E930              <1>     sub cl, "0"
    87 00000717 390D(18000000)      <1>     cmp dword [dMaxSesIndx], ecx
    88 0000071D 7205                <1>     jb badChoice
    89                              <1> ;Jump with with cl containing the new (valid) session number
    90 0000071F E949FDFFFF          <1>     jmp gotoSession 
    91                              <1> badChoice:
    92                              <1> ;Beep at the user and then reset the screen, show display!
    93 00000724 B207                <1>     mov dl, 07h ;Beep at the user (Do I want to do that?)
    94 00000726 E84B000000          <1>     call putch
    95 0000072B E9CAFEFFFF          <1>     jmp shellMain
    96                              <1> resetScreen:            ;Now reset the screen!
    97 00000730 B802000000          <1>     mov eax, 2          ;Driver Reset screen command!
    98 00000735 FF15(1C000000)      <1>     call qword [pConIOCtl]
    99                              <1>     return 
    13 0000073B C3                  <2>  ret
