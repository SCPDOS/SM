    28 0000038F 80FC03              <1>     cmp ah, 03h
    29 00000392 741A                <1>     je ioblock
    30 00000394 80FC80              <1>     cmp ah, 80h
    31 00000397 7417                <1>     je critInc
    32 00000399 80FC81              <1>     cmp ah, 81h
    33 0000039C 741A                <1>     je critDec
    34 0000039E 80FC82              <1>     cmp ah, 82h
