     1                              <1> 
     2                              <1> ;-------------------------------------------------------------------------------
     3                              <1> ;Generic Macros file
     4                              <1> ;The following instruction extensions allow to conditionally return
     5                              <1> ;The idea was borrowed from the DOS Source Code
     6                              <1> ;
     7                              <1> ;-------------------------------------------------------------------------------
     8                              <1> 
     9                              <1> ;-------------------------------------------------------------------------------
    10                              <1> ;These macros are live and must not be touched
    11                              <1> ;-------------------------------------------------------------------------------
    12                              <1> %macro return 0
    13                              <1>     ret
    14                              <1> %endmacro
    15                              <1> 
    16                              <1> %macro cret 1
    17                              <1>     j%-1 short %%a
    18                              <1>     return
    19                              <1> %%a:
    20                              <1> %endmacro
    21                              <1> 
    22                              <1> %macro retz 0
    23                              <1> cret z
    24                              <1> %endmacro
    25                              <1> 
    26                              <1> %macro retnz 0
    27                              <1> cret nz
    28                              <1> %endmacro
    29                              <1> 
    30                              <1> %macro rete 0
    31                              <1> cret e
    32                              <1> %endmacro
    33                              <1> 
    34                              <1> %macro retne 0
    35                              <1> cret ne
    36                              <1> %endmacro
    37                              <1> 
    38                              <1> %macro retc 0
    39                              <1> cret c
    40                              <1> %endmacro
    41                              <1> 
    42                              <1> %macro retnc 0
    43                              <1> cret nc
    44                              <1> %endmacro
    45                              <1> 
    46                              <1> %macro retb 0
    47                              <1> cret b
    48                              <1> %endmacro
    49                              <1> 
    50                              <1> %macro retnb 0
    51                              <1> cret nb
    52                              <1> %endmacro
    53                              <1> 
    54                              <1> %macro reta 0
    55                              <1> cret a
    56                              <1> %endmacro
    57                              <1> 
    58                              <1> %macro retna 0
    59                              <1> cret na
    60                              <1> %endmacro
    61                              <1> 
    62                              <1> %macro breakpoint 0
    63                              <1> xchg bx, bx
    64                              <1> %endmacro
     6                                  
     7                                  Segment cseg code private align=16
     8                                  %include "./src/text/init.asm"
     1                              <1>     GLOBAL ep
     2                              <1> 
     3                              <1> ;Init code for Session Manager.
     4                              <1> ep:  ;Entry Point for SM
     5 00000000 B800300000          <1>     mov eax, 3000h  ;Get version number
     6 00000005 CD21                <1>     int 21h
     7 00000007 3C01                <1>     cmp al, 1   ;If the major number is 1 or below
     8 00000009 7615                <1>     jbe proceedBss
     9 0000000B 488D15(32000000)    <1>     lea rdx, bvStr
    10                              <1> exitBad:
    11                              <1> ;Bad exits in init jump here
    12 00000012 B800090000          <1>     mov eax, 0900h
    13 00000017 CD21                <1>     int 21h
    14 00000019 B8FF4C0000          <1>     mov eax, 4CFFh
    15 0000001E CD21                <1>     int 21h
    16                              <1> proceedBss:
    17                              <1> ;Clean the BSS
    18                              <1>     ;lea rdi, bseg_start
    19                              <1>     ;mov ecx, bseg_len
    20                              <1>     ;xor eax, eax
    21                              <1>     ;rep stosb
    22                              <1> ;Check that SM is not already installed
    23 00000020 B8000A0000          <1>     mov eax, SM_SIG_2F << 8
    24 00000025 CD2F                <1>     int 2Fh
    25 00000027 84C0                <1>     test al, al
    26 00000029 7409                <1>     jz .proceedInstall
    27 0000002B 488D15(ED010000)    <1>     lea rdx, alrInstStr
    28 00000032 EBDE                <1>     jmp short exitBad
    29                              <1> .proceedInstall:
    30                              <1> ;Check that STDIO is not redirected from the standard console device.
    31                              <1> ;This can be an AUX driver, the test for MCON compliance occurs below!
    32                              <1> ;If it is, exit complaining!
    33 00000034 31DB                <1>     xor ebx, ebx    ;STDIN
    34 00000036 B800440000          <1>     mov eax, 4400h  ;Get Hdl info
    35 0000003B CD21                <1>     int 21h
    36 0000003D 89D3                <1>     mov ebx, edx    ;Save the returned word in bx
    37 0000003F 488D15(6C010000)    <1>     lea rdx, noIOCTLStr
    38 00000046 72CA                <1>     jc exitBad
    39 00000048 488D15(8E010000)    <1>     lea rdx, noStdinStr
    40 0000004F 81E381000000        <1>     and ebx, 81h    ;Save bits 7 and 0 (Char dev and STDIN device)
    41 00000055 81FB81000000        <1>     cmp ebx, 81h
    42 0000005B 75B5                <1>     jne exitBad
    43                              <1> 
    44 0000005D BB01000000          <1>     mov ebx, 1      ;STDOUT
    45 00000062 B800440000          <1>     mov eax, 4400h  ;Get Hdl info
    46 00000067 CD21                <1>     int 21h
    47 00000069 89D3                <1>     mov ebx, edx    ;Save the returned word in bx
    48 0000006B 488D15(6C010000)    <1>     lea rdx, noIOCTLStr
    49 00000072 729E                <1>     jc exitBad
    50 00000074 488D15(BD010000)    <1>     lea rdx, noStdoutStr
    51 0000007B 81E382000000        <1>     and ebx, 82h    ;Save bits 7 and 1 (Char dev and STDOUT device)
    52 00000081 81FB82000000        <1>     cmp ebx, 82h
    53 00000087 7589                <1>     jne exitBad
    54                              <1> ;XCHG ptrs with MCON, driver specific IOCTL call
    55 00000089 31F6                <1>     xor esi, esi
    56 0000008B 31FF                <1>     xor edi, edi
    57 0000008D 56                  <1>     push rsi        ;Push two 0's onto the stack to allocate struc on stack
    58 0000008E 56                  <1>     push rsi
    59 0000008F 4889E2              <1>     mov rdx, rsp    ;Allocated structure on the stack
    60 00000092 66C7020001          <1>     mov word [rdx + mScrCap.wVer], 0100h
    61 00000097 66C742020F00        <1>     mov word [rdx + mScrCap.wLen], mScrCap_size
    62 0000009D 66C742040071        <1>     mov word [rdx + mScrCap.wMagic], magicCode
    63 000000A3 488D1D51030000      <1>     lea rbx, DosSesHlp
    64 000000AA 48895A07            <1>     mov qword [rdx + mScrCap.qHlpPtr], rbx
    65 000000AE B80C440000          <1>     mov eax, 440Ch
    66 000000B3 31DB                <1>     xor ebx, ebx    ;CON handle (STDIN)!
    67 000000B5 B910030000          <1>     mov ecx, 0310h  ;CON + Reports capacities!
    68 000000BA CD21                <1>     int 21h
    69 000000BC 730C                <1>     jnc mConOk
    70 000000BE 488D15(55000000)    <1>     lea rdx, noConStr
    71 000000C5 E948FFFFFF          <1>     jmp exitBad
    72                              <1> mConOk:
    73 000000CA 488B5A07            <1>     mov rbx, qword [rdx + mScrCap.qHlpPtr]
    74 000000CE 48891D(1C000000)    <1>     mov qword [pConIOCtl], rbx ;Store the help pointer
    75 000000D5 0FB65A06            <1>     movzx ebx, byte [rdx + mScrCap.bScrNum]
    76 000000D9 B808000000          <1>     mov eax, 8      ;Maximum supported, 8 screens
    77 000000DE 39C3                <1>     cmp ebx, eax
    78 000000E0 0F47D8              <1>     cmova ebx, eax  ;Maximum supported session number is 7
    79 000000E3 FFCB                <1>     dec ebx         ;Turn into an index
    80 000000E5 891D(18000000)      <1>     mov dword [dMaxSesIndx], ebx   ;Store the max session number index.
    81                              <1> ;Restore the stack now!
    82 000000EB 5E                  <1>     pop rsi  
    83 000000EC 5E                  <1>     pop rsi
    84 000000ED 85DB                <1>     test ebx, ebx   ;If only one session possible, fail to start!
    85 000000EF 750C                <1>     jnz screensOk    ;Else, we know we have enough screens to proceed usefully!
    86                              <1> ;If not enough screens, indicate we are aborting!
    87 000000F1 488D15(7A000000)    <1>     lea rdx, noScreenStr
    88 000000F8 E915FFFFFF          <1>     jmp exitBad
    89                              <1> screensOk:
    90                              <1> ;Get the size of the SDA to know how big a psda actually is.
    91                              <1> ;    breakpoint
    92 000000FD B8065D0000          <1>     mov eax, 5D06h
    93 00000102 CD21                <1>     int 21h
    94 00000104 488935(00000000)    <1>     mov qword [pDosSda], rsi
    95 0000010B 890D(14000000)      <1>     mov dword [dSdaLen], ecx    ;Save the larger value :)
    96 00000111 81C1A8000000        <1>     add ecx, psda_size
    97 00000117 890D(10000000)      <1>     mov dword [dPsdaLen], ecx   ;Save the max length of a psda.
    98 0000011D 89C8                <1>     mov eax, ecx
