   240                              <1> getIntVector:
   241                              <1> ;Called with:
   242                              <1> ;Interrupts Off!
   243                              <1> ; al = Interrupt number
   244                              <1> ;Returns: 
   245                              <1> ; rbx -> Ptr to interrupt handler
   246 00000584 0F010D(4A000000)    <1>     sidt [pIDT]    ;Get the current IDT base pointer
   247 0000058B 0FB6C0              <1>     movzx eax, al
   248 0000058E 48C1E004            <1>     shl rax, 4h     ;Multiply IDT entry number by 16 (Size of IDT entry)
   249 00000592 480305(4C000000)    <1>     add rax, qword [pIDT.base]    
   250 00000599 31DB                <1>     xor ebx, ebx
   251 0000059B 8B5808              <1>     mov ebx, dword [rax + 8]    ;Get bits 63...32
   252 0000059E 48C1E310            <1>     shl rbx, 10h    ;Push the high dword high
   253 000005A2 668B5806            <1>     mov bx, word [rax + 6]      ;Get bits 31...16
   254 000005A6 48C1E310            <1>     shl rbx, 10h    ;Push word 2 into posiiton
   255 000005AA 668B18              <1>     mov bx, word [rax]          ;Get bits 15...0
   256                              <1>     return
    13 000005AD C3                  <2>  ret
   257                              <1> 
   258                              <1> setIntVector:
   259                              <1> ;Called with:
   260                              <1> ;Interrupts Off!
   261                              <1> ;   rdx = Pointer to interrupt handler
   262                              <1> ;   al = Interrupt number
   263 000005AE 0F010D(4A000000)    <1>     sidt [pIDT]    ;Get the current IDT base pointer
   264 000005B5 0FB6C0              <1>     movzx eax, al
   265 000005B8 48C1E004            <1>     shl rax, 4h     ;Multiply IDT entry number by 16 (Size of IDT entry)
   266 000005BC 480305(4C000000)    <1>     add rax, qword [pIDT.base]    
   267 000005C3 668910              <1>     mov word [rax], dx  ;Get low word into offset 15...0
   268 000005C6 48C1EA10            <1>     shr rdx, 10h    ;Bring next word low
   269 000005CA 66895006            <1>     mov word [rax + 6], dx  ;Get low word into offset 31...16
   270 000005CE 48C1EA10            <1>     shr rdx, 10h    ;Bring last dword low
   271 000005D2 895008              <1>     mov dword [rax + 8], edx
   272                              <1>     return
    13 000005D5 C3                  <2>  ret
